	)
	(text "3.3 V logic only: J3_IO1-8 go straight to MCU pins\n(no buffer or protection). IO3/IO4 = I2C3 SCL/SDA,\nIO5-IO8 = SPI2. Full map: pinmap/README.md."
		(exclude_from_sim no)
		(at 320.04 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "65fc543e-3e97-4f8f-af1c-62f6c94ca4a7")
	)
	(text "BOOT0: hold SW1, press RESET -> ROM USB DFU bootloader.\nSW3 on PC13 (WKUP2), active low: can wake from Standby."
		(exclude_from_sim no)
		(at 17.78 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "835ad523-71c1-4ba6-a0e0-3d00ecafd77b")
	)
	(text "STM32U575VIT6, LQFP-100. Flight part STM32U5A5VJT6 fits the same\nfootprint; never fit a Q (SMPS) part. Pins: pinmap/pinmap.csv.\nThe 46 unused I/O are NC-flagged and free for bodge wires."
		(exclude_from_sim no)
		(at 100.33 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "84947987-5b52-441d-89fb-aa43ad725622")
	)
