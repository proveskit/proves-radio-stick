	)
	(text "RF_VCC = VBUS via FB1 and load switch U19 (>= 5 V for 30 dBm).\nCT 1 nF -> 2.9 ms ramp, 0.19 A inrush into 110 uF.\nON = RF_PWR_EN (PE2). R95 to +3V3 = radio ON by default;\nmove R95 to GND for default OFF.\nRF_VCC = (4.7, 5.0, 5.25) V @ (0.005, 0.1, 0.65) A"
		(exclude_from_sim no)
		(at 236.22 67.31 0)
		(effects
