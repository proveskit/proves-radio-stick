	(text "C101-C105 VDD 11/28/50/75/100, C106 VDDUSB 73,\nC107 4.7u bulk, C108 VBAT 6, C109/C110 VDDA 22,\nC111/C112 VREF+ 21, C113 VCAP 48 (LDO), C114 NRST 14"
		(exclude_from_sim no)
		(at 16.51 143.51 0)
