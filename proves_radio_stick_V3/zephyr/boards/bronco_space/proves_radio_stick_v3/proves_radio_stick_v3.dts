/*
 * PROVES Radio Stick V3: STM32U575VIT6 (LQFP-100) + EByte E22-400M30S (SX1268).
 * Pin map: proves_radio_stick_V3/pinmap/pinmap.csv
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/u5/stm32u575Xi.dtsi>
#include <st/u5/stm32u575vitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
	model = "PROVES Radio Stick V3";
	compatible = "bronco-space,proves-radio-stick-v3";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";

		/* D1 "Firmware_Active": PB0 -> R13 -> LED -> GND */
		fw_led: led_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "Firmware Active LED";
		};

		/* D2 user LED: PC6 -> R103 -> LED -> GND */
		user_led: led_1 {
			gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
			label = "User LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		/* SW3 to GND, R102 10k pull-up. PC13 is WKUP2. */
		user_button: button_0 {
			label = "User";
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * U19 TPS22918 load switch feeding the E22 from VBUS. R95 pulls ON high,
	 * so the radio is powered from reset; drive low to power-cycle it.
	 */
	rf_vcc: rf-vcc {
		compatible = "regulator-fixed";
		regulator-name = "RF_VCC";
		enable-gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <5000>;
		regulator-boot-on;
	};

	zephyr,user {
		/* USB-C CC1/CC2 (5.1k Rd): read the host's current advertisement. */
		io-channels = <&adc1 16>, <&adc1 17>;
		io-channel-names = "cc1", "cc2";
	};

	aliases {
		led0 = &fw_led;
		led1 = &user_led;
		sw0 = &user_button;
		lora0 = &lora0;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
	};
};

/*
 * Y101 16 MHz HSE -> PLL1 VCO 480 MHz:
 *   R /3 = 160 MHz SYSCLK, Q /10 = 48 MHz for USB (crystal accuracy).
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* Y102 32.768 kHz LSE for RTC and the low-power tick; medium-high drive for margin. */
&clk_lse {
	driving-capability = <2>;
	status = "okay";
};

&clk_msis {
	status = "okay";
	msi-range = <4>;
	msi-pll-mode;
};

&pll1 {
	div-m = <1>;
	mul-n = <30>;
	div-q = <10>;
	div-r = <3>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

stm32_lp_tick_source: &lptim1 {
	clocks = <&rcc STM32_CLOCK(APB3, 11)>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB3, 21)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	clocks = <&rcc STM32_CLOCK(AHB2, 14)>,
		 <&rcc STM32_SRC_PLL1_Q ICKLK_SEL(2)>;
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * E22-400M30S on SPI1. NSS is PC4 as a GPIO chip select. The radio pins avoid
 * PA15/PB5/PB14/PB15, which carry the UCPD1 CC and dead-battery functions.
 */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	lora0: lora@0 {
		/*
		 * The E22-400M30S is an SX1268. Like FC v5e, describe it as an
		 * SX1262 (same register interface) so it uses the loramac-node
		 * backend the flight software builds with; Zephyr only accepts
		 * "semtech,sx1268" via the LoRa Basics Modem module.
		 */
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		reset-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		/* R11/R12 hold RXEN/TXEN low until the driver takes over. */
		tx-enable-gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
		/* Same module and settings as FC v5e. */
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <10>;
		rx-boosted;
	};
};

/* VCP on J5 (STDC14). */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};


/*
 * ADC1: CC sense (IN16 PB1, IN17 PB2). J3's analog-capable pins are
 * IN5 PA0, IN6 PA1, IN1 PC0, IN2 PC1 and IN9 PA4.
 */
&adc1 {
	pinctrl-0 = <&adc1_in16_pb1 &adc1_in17_pb2>;
	pinctrl-names = "default";
	st,adc-clock-source = "ASYNC";
	st,adc-prescaler = <4>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@10 {
		reg = <16>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@11 {
		reg = <17>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/*
 * J3 breakout. I2C3, SPI2 and UART4 sit on separate pins, so a face board,
 * an SD breakout and a UART device can all be connected at once. They are
 * pre-wired but disabled; enable them in an overlay, e.g.
 * `&spi2 { status = "okay"; };`.
 *
 *   J3 2 PA0 UART4_TX   J3 3 PA1 UART4_RX
 *   J3 4 PC0 I2C3_SCL   J3 5 PC1 I2C3_SDA  (R104/R105 4.7k pull-ups)
 *   J3 6 PB13 SPI2_SCK  J3 7 PC2 SPI2_MISO  J3 8 PC3 SPI2_MOSI
 *   J3 9 PA4 SPI2 chip select (GPIO), or DAC1_OUT1
 */
&uart4 {
	pinctrl-0 = <&uart4_tx_pa0 &uart4_rx_pa1>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pc0 &i2c3_sda_pc1>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pc2 &spi2_mosi_pc3>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
};

&dac1 {
	pinctrl-0 = <&dac1_out1_pa4>;
	pinctrl-names = "default";
};

&iwdg {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&rng {
	status = "okay";
};

&gpdma1 {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* MCUboot layout, matching the PROVES flight software. */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(960)>;
		};

		slot1_partition: partition@100000 {
			label = "image-1";
			reg = <0x00100000 DT_SIZE_K(960)>;
		};

		storage_partition: partition@1f0000 {
			label = "storage";
			reg = <0x001f0000 DT_SIZE_K(64)>;
		};
	};
};

/* Console and shell on USB CDC-ACM (needs zephyr_udc0 above). */
#include <../boards/common/usb/cdc_acm_serial.dtsi>
