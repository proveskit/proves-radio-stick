/*
 * PROVES Radio Stick V3: STM32U585CIU6 + EByte E22-400M30S (SX1268).
 * Pin map: proves_radio_stick_V3/pinmap/README.md
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/u5/stm32u585Xi.dtsi>
#include <st/u5/stm32u585ciux-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
	model = "PROVES Radio Stick V3";
	compatible = "bronco-space,proves-radio-stick-v3";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";

		/* D1 "Firmware_Active": PB0 -> R13 -> LED -> GND */
		fw_led: led_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "Firmware Active LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		/* SW3 to GND, R102 10k pull-up. PC13 is WKUP2. */
		user_button: button_0 {
			label = "User";
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * U19 TPS22918 load switch feeding the E22 from VBUS. R95 pulls ON high,
	 * so the radio is powered from reset; drive low to power-cycle it.
	 */
	rf_vcc: rf-vcc {
		compatible = "regulator-fixed";
		regulator-name = "RF_VCC";
		enable-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <5000>;
		regulator-boot-on;
	};

	zephyr,user {
		/* USB-C CC1/CC2 (5.1k Rd): read the host's current advertisement. */
		io-channels = <&adc1 16>, <&adc1 17>;
		io-channel-names = "cc1", "cc2";
	};

	aliases {
		led0 = &fw_led;
		sw0 = &user_button;
		lora0 = &lora0;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
	};
};

/*
 * Y101 16 MHz HSE -> PLL1 VCO 480 MHz:
 *   R /3 = 160 MHz SYSCLK, Q /10 = 48 MHz for USB (crystal accuracy).
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* Y102 32.768 kHz LSE for RTC and the low-power tick. */
&clk_lse {
	status = "okay";
};

&clk_msis {
	status = "okay";
	msi-range = <4>;
	msi-pll-mode;
};

&pll1 {
	div-m = <1>;
	mul-n = <30>;
	div-q = <10>;
	div-r = <3>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll1>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

stm32_lp_tick_source: &lptim1 {
	clocks = <&rcc STM32_CLOCK(APB3, 11)>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB3, 21)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	clocks = <&rcc STM32_CLOCK(AHB2, 14)>,
		 <&rcc STM32_SRC_PLL1_Q ICKLK_SEL(2)>;
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

/* E22-400M30S on SPI1. NSS is PA15 as a GPIO chip select. */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
	status = "okay";

	lora0: lora@0 {
		/*
		 * The E22-400M30S is an SX1268. Like FC v5e, describe it as an
		 * SX1262 (same register interface) so it uses the loramac-node
		 * backend the flight software builds with; Zephyr only accepts
		 * "semtech,sx1268" via the LoRa Basics Modem module.
		 */
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		reset-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		/* R11/R12 hold RXEN/TXEN low until the driver takes over. */
		tx-enable-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
		/* Same module and settings as FC v5e. */
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <10>;
		rx-boosted;
	};
};

/* VCP on J5 (STDC14) and the UART on J4. Shared: use one at a time. */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* J4 I2C, R39/R41 10k pull-ups on board. */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

/*
 * ADC1: CC sense (IN16 PB1, IN17 PB2) plus the J3 analog pins
 * (IN5-IN9 on PA0-PA4). J3 pins stay GPIO until an app claims them.
 */
&adc1 {
	pinctrl-0 = <&adc1_in16_pb1 &adc1_in17_pb2>;
	pinctrl-names = "default";
	st,adc-clock-source = "ASYNC";
	st,adc-prescaler = <4>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@10 {
		reg = <16>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@11 {
		reg = <17>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/*
 * J3 breakout peripherals, pre-wired but disabled. Enable one in an
 * overlay, e.g. `&spi2 { status = "okay"; };`. They share pins, so only
 * enable one user per pin.
 */
&dac1 {
	pinctrl-0 = <&dac1_out1_pa4>;		/* J3 pin 6 */
	pinctrl-names = "default";
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;	/* J3 7-9 */
	pinctrl-names = "default";
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb13 &i2c2_sda_pb14>;	/* J3 7-8 */
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;	/* J3 4-5 */
	pinctrl-names = "default";
	current-speed = <115200>;
};

&timers2 {
	st,prescaler = <0>;

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1 &tim2_ch3_pa2 &tim2_ch4_pa3>;	/* J3 2-5 */
		pinctrl-names = "default";
	};
};

&iwdg {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&rng {
	status = "okay";
};

&gpdma1 {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* MCUboot layout, matching the PROVES flight software. */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(960)>;
		};

		slot1_partition: partition@100000 {
			label = "image-1";
			reg = <0x00100000 DT_SIZE_K(960)>;
		};

		storage_partition: partition@1f0000 {
			label = "storage";
			reg = <0x001f0000 DT_SIZE_K(64)>;
		};
	};
};

/* Console and shell on USB CDC-ACM (needs zephyr_udc0 above). */
#include <../boards/common/usb/cdc_acm_serial.dtsi>
